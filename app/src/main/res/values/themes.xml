<!--https://www.youtube.com/watch?v=ApqX9FQA4k0 - Popup-->
<resources>
    <!-- Base application theme. -->
    <style name="Theme.Theme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimaryDark">@color/purple_900</item>
        <item name="colorPrimary">@color/purple_900</item>
        <item name="colorPrimaryVariant">@color/purple_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:textColorPrimary">@color/colorWhite</item>
        <item name="android:textColor">@color/purple_700</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
        <item name="android:textColorSecondary">@color/white</item> <!-- Colours overflow icon -->
        <!--        <item name="android:titleTextStyle" tools:targetApi="l">?attr/colorOnPrimary</item>-->
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.PopupTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:background">@color/white</item> <!-- background colour in Popup -->
        <item name="android:colorBackground">@color/colorPureRed
        </item> <!-- background colour in Popup -->
        <item name="android:textColor">@color/purple_700</item> <!-- text colour in Popup -->
        <item name="colorControlNormal">@color/white</item>
        <item name="colorPrimarySurface">@color/white</item>
        <item name="android:textColorSecondary">#ffffff</item>
        <item name="android:actionOverflowButtonStyle">@color/white</item>
    </style>

    <style name="Settings" parent="Theme.Theme">
        <item name="android:textColorSecondary">@color/purple_700</item>
        <item name="android:editTextColor">@color/purple_700</item>
        <item name="colorSecondary">@color/purple_200</item>
        <item name="colorSecondaryVariant">@color/purple_500</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:color">@color/black</item>
    </style>

    <style name="Widget.ActionMode.ActionBar" parent="@style/ThemeOverlay.AppCompat.DayNight">
        <item name="colorPrimaryDark">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="editText" parent="@style/ThemeOverlay.AppCompat.DayNight">
        <item name="android:editTextStyle">@color/colorPureRed</item>
    </style>
</resources>