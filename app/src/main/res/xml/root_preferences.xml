<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/observer_details">
        <EditTextPreference
            android:contentDescription="@string/observerName"
            android:selectAllOnFocus="true"
            app:key="observer"
            app:summary="@string/observerName"
            app:title="@string/observer" />

        <EditTextPreference
            android:contentDescription="@string/observerContactNumber"
            android:selectAllOnFocus="true"
            app:isPreferenceVisible="true"
            app:key="mobile"
            app:summary="@string/observerContactNumber"
            app:title="@string/contact" />

        <EditTextPreference
            android:contentDescription="@string/enterSectionNumber"
            app:dialogMessage="Section selection"
            app:dialogTitle="Section Number"
            app:isPreferenceVisible="true"
            app:key="sectionText"
            app:singleLineTitle="false"
            app:summary="@string/enterSectionNumber"
            app:title="@string/section_number" />

        <EditTextPreference
            android:contentDescription="@string/enterRiderNumber"
            android:selectAllOnFocus="true"
            app:key="riderText"
            app:summary="@string/riding_number"
            app:title="@string/riding_number" />
    </PreferenceCategory>

    <PreferenceCategory
        android:contentDescription="@string/this_section_sets_details_of_your_trial"
        app:key="trial_details"
        app:title="@string/trial_header">

        <ListPreference
            android:contentDescription="@string/select_trial_from_available_choices"
            android:title="@string/select_trial"
            app:entries="@array/trial_entries"
            app:entryValues="@array/trial_values"
            app:key="theTrialIndex"
            app:summary="@string/select_trial"
            app:title="@string/trial_name" />

        <EditTextPreference
            android:contentDescription="@string/enter_trial_name"
            android:selectAllOnFocus="true"
            app:key="trialName"
            app:summary="@string/enter_trial_name"
            app:title="@string/trial_name" />

        <EditTextPreference
            android:contentDescription="@string/enter_your_email_address"
            android:selectAllOnFocus="true"
            app:key="email"
            app:summary="@string/enter_your_email_address"
            app:title="@string/email" />

        <EditTextPreference
            android:contentDescription="@string/enter_number_of_laps"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            app:isPreferenceVisible="true"
            app:key="numlapsText"
            app:summary="@string/enter_number_of_laps"
            app:title="@string/number_of_laps" />

        <EditTextPreference
            android:contentDescription="@string/enter_number_of_sections"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            app:isPreferenceVisible="true"
            app:key="numsectionsText"
            app:summary="@string/enter_number_of_sections"
            app:title="@string/number_of_sections" />
    </PreferenceCategory>


    <PreferenceCategory android:title="Admin">
        <SwitchPreference
            android:contentDescription="@string/advanced__settings"
            android:defaultValue="false"
            android:key="show_advanced"
            app:isPreferenceVisible="false"
            android:title="@string/advanced_settings"
            app:summary="@string/advanced__settings" />

        <EditTextPreference
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:key="adminLock"
            android:title="@string/password"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            app:isPreferenceVisible="true"
            app:key="adminLockPass" />
        <EditTextPreference
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/new_password"
            app:enableCopying="false"
            app:isPreferenceVisible="false"
            app:key="adminLockNewPass"
            app:summary="@string/enter_new_password" />
        <EditTextPreference
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:key="adminLockConfirmPass"
            app:isPreferenceVisible="false"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/confirm_password"
            app:summary="@string/enter_confirm_password"
            app:key="adminLockConfirmPass" />
        <PreferenceCategory
            android:key="loginPrefCategory"
            android:title="@string/login_details">

            <EditTextPreference
                android:contentDescription="@string/accountUser"
                android:defaultValue=""
                android:key="username"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:title="@string/username"
                app:summary="Enter login username"
                app:useSimpleSummaryProvider="true" />
            <EditTextPreference
                android:contentDescription="@string/password"
                android:defaultValue=""
                android:key="password"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:title="@string/password"
                app:summary="Enter login password" />
        </PreferenceCategory>
        <PreferenceCategory
            android:key="timingModeCategory"
            android:title="@string/timing_mode">
            <SwitchPreference
                android:contentDescription="@string/enter_timing_mode"
                android:defaultValue="false"
                android:key="timeMode"
                android:title="@string/timing_mode_switch" />

            <EditTextPreference
                android:contentDescription="@string/enter_start_interval"
                android:defaultValue="60"
                android:key="startIntervalText"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:title="Start interval"
                app:summary="@string/enter_start_interval" />

            <EditTextPreference
                android:contentDescription="@string/enter_penalty_tariff"
                android:defaultValue="60"
                android:key="penaltyTariffText"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:title="Penalty tariff"
                app:summary="@string/enter_penalty_tariff" />

        </PreferenceCategory>
        <SwitchPreference
            android:contentDescription="@string/restart_clock"
            android:defaultValue="false"
            android:icon="@drawable/ic_warning_24dp"
            android:key="restart_clock_preference"
            android:summary="@string/reset_clock"
            android:title="@string/restart_clock" />
        <SwitchPreference
            android:contentDescription="@string/reset_scores"
            android:defaultValue="false"
            android:icon="@drawable/ic_warning_24dp"
            android:key="reset_scores_preference"
            android:summary="@string/reset_scores"
            android:title="@string/reset_scores" />
        <SwitchPreference
            android:contentDescription="@string/reset_times"
            android:defaultValue="false"
            android:icon="@drawable/ic_warning_24dp"
            android:key="reset_times_preference"
            android:summary="@string/reset_times"
            android:title="@string/reset_times" />
    </PreferenceCategory>
</PreferenceScreen>