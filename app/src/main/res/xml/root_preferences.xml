<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <PreferenceCategory app:title="@string/observer_details">
        <EditTextPreference
            android:selectAllOnFocus="true"
            app:key="observer"
            app:title="@string/observer"
            android:contentDescription="@string/observerName"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:selectAllOnFocus="true"
            app:isPreferenceVisible="true"
            app:key="mobile"
            app:title="@string/contact"
            android:contentDescription="@string/observerContactNumber"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="sectionText"
            app:isPreferenceVisible="true"
            app:title="@string/section_number"
            android:contentDescription="@string/enterSectionNumber"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:selectAllOnFocus="true"
            app:key="riderText"
            app:title="@string/riding_number"
            android:contentDescription="@string/enterRiderNumber"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="trial_details"
        android:contentDescription="@string/this_section_sets_details_of_your_trial"
        app:title="@string/trial_header">

        <SwitchPreference
            android:contentDescription="@string/toggleManualEntry"
            android:defaultValue="false"
            android:key="manualTrial"
            android:title="Manual" />

        <ListPreference
            android:title="@string/select_trial"
            app:entries="@array/trial_entries"
            app:entryValues="@array/trial_values"
            app:key="theTrialIndex"
            app:title="@string/trial_name"
            android:contentDescription="@string/select_trial_from_available_choices"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:selectAllOnFocus="true"
            app:key="trialName"
            app:title="@string/trial_name"
            android:contentDescription="@string/enter_trial_name"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:selectAllOnFocus="true"
            app:key="email"
            android:contentDescription="@string/enter_your_email_address"
            app:title="@string/email"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:contentDescription="@string/enter_number_of_laps"
            app:key="numlapsText"
            app:isPreferenceVisible="true"
            app:title="@string/number_of_laps"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:selectAllOnFocus="true"
            android:singleLine="true"
            app:key="numsectionsText"
            app:isPreferenceVisible="true"
            app:title="@string/number_of_sections"
            android:contentDescription="@string/enter_number_of_sections"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Mode">
        <SwitchPreference
            android:defaultValue="false"
            android:key="timeMode"
            android:contentDescription="@string/enter_timing_mode"
            android:title="@string/timing_mode" />

        <EditTextPreference
            android:defaultValue="60"
            android:key="startIntervalText"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="Start interval"
            android:contentDescription="@string/enter_start_interval"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:defaultValue="60"
            android:key="penaltyTariffText"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="Penalty tariff"
            android:contentDescription="@string/enter_penalty_tariff"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="Advanced"
        android:icon="@drawable/ic_baseline_warning_24">
        <SwitchPreference
            android:defaultValue="false"
            android:key="show_advanced"
            android:contentDescription="@string/advanced__settings"
            android:title="@string/advanced_settings" />

        <PreferenceCategory
            android:key="loginPrefCategory"
            android:title="@string/login_details">

            <EditTextPreference
                android:contentDescription="@string/accountUser"
                android:defaultValue=""
                android:key="@string/account"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:title="@string/username"
                app:useSimpleSummaryProvider="true" />
            <EditTextPreference
                android:contentDescription="@string/password"
                android:defaultValue=""
                android:key="password"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:title="@string/password" />
        </PreferenceCategory>

        <SwitchPreference
            android:defaultValue="false"
            android:key="restart_clock_preference"
            android:contentDescription="@string/restart_clock"
            android:title="@string/restart_clock" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="reset_scores_preference"
            android:contentDescription="@string/reset_scores"
            android:title="@string/reset_scores" />
        <SwitchPreference
            android:defaultValue="false"
            android:key="reset_times_preference"
            android:contentDescription="@string/reset_times"
            android:title="@string/reset_times" />
    </PreferenceCategory>
</PreferenceScreen>